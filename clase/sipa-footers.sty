% ===============================================
%	Plain / section footer with pages
% ===============================================

\newcommand{\footerpages}{%
\begin{tikzpicture}[
	x=1mm,
	y=1mm,
	inner sep=0pt,
	outer sep=0pt,
	remember picture,
	overlay
]

\begin{scope}
	\setlength{\hoffset}{0in}
	\path (current page.south west) coordinate (paperSW);
	
	\begin{scope}[shift={(paperSW)}]
		
		\fill[lightgreen] (0,0) rectangle (210,14);
		\fill[midgreen] (0,0) rectangle (210,12);
		\fill[darkgreen] (0,0) rectangle (210,10);

		% Centered footer logo
		\node[anchor=center] at (105,5) {%
			\includegraphics[width=9mm, height=9mm, keepaspectratio]{portada/sipa pin}%
		};

		% Centered page number
		\node[anchor=center, text=white, font=\bfseries\fontsize{8}{9}\selectfont]
		at (105,5.8) {\thepage};
		
	\end{scope}
\end{scope}

\end{tikzpicture}%
}

