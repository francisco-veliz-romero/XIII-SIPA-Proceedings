%==============================
% Functions to abbreviate names
%==============================

% Function to abbreviate names (alone or divided by a hyphen)
\newcommand{\processsurname}[2]{%
	\begingroup
	\IfSubStr{#1}{-}{%
		% Hyphenated name: nameA-nameB
		\StrBefore{#1}{-}[\sa]%
		\StrBehind{#1}{-}[\sb]%
		\StrLeft{\sa}{1}[\si]%
		\StrLeft{\sb}{1}[\sj]%
		\xdef#2{\si.-\sj.}%
	}{%
		% Non-hyphenated name: nameB
		\StrLeft{#1}{1}[\si]%
		\xdef#2{\si.}%
	}%
	\endgroup
}

% The three names can be normal or divided by a hypen
% In that way you dont need to place the hyphenated names in different fields
\newcommand{\abbrevnombs}[4]{%
	\begingroup
	\def\given{#1}%
	
	% First name
	\processsurname{#2}{\outA}%
	
	\def\temp{\given, \outA}%
	% Second name (optional)
	\IfStrEq{#3}{}{}{%
		\processsurname{#3}{\outB}%
		\edef\temp{\temp\space\outB}%
	}%
	% Third name (optional)
	\IfStrEq{#4}{}{}{%
		\processsurname{#4}{\outC}%
		\edef\temp{\temp\space\outC}%
	}%
	
	\xdef\@abbrevnombs{\temp}
	\endgroup
}

%==============================
%	Other data functions
%==============================

% Defines if the header should write the main document author abbreviated name
% "no" allows you to place the Author's name in the header
% "yes" leaves a blanc spaceto write the section's custom title
% "alone" removes the line and makes the header title be in the middle of the text area
\newcommand{\@pagenblanc}{}
\newcommand{\pagenblanc}[1]{%
	\ifstrequal{#1}{yes}{\renewcommand{\@pagenblanc}{0}}{%
		\ifstrequal{#1}{no}{\renewcommand{\@pagenblanc}{1}}{%
			\ifstrequal{#1}{alone}{\renewcommand{\@pagenblanc}{2}}{}
		}%
	}%
}

% Section's custom title
\newcommand{\@nombsec}{}
\newcommand{\nombsec}[1]{\gdef\@nombsec{#1}}

% Name printed in TOC
\newcommand{\@tocauthor}{}
\newcommand{\tocauthor}[1]{\renewcommand{\@tocauthor}{#1}}

% Author's afiliation
\newcommand{\@affiliations}{}
\newcommand{\ijaffiliation}[1]{%
	\renewcommand{\@affiliations}{#1}%
}

% Functions to add the corresponding author's mail
% The first function prints text before the mai
% The second function prints the email
\newcommand{\@correspondingtext}{}
\newcommand{\@correspondingmail}{}

\newcommand{\corresponding}[2]{%
	\renewcommand{\@correspondingtext}{#1}%
	\renewcommand{\@correspondingmail}{#2}%
}

% Functions to add the Author's name to TOC
\newcommand{\l@titlewithoutpage}[2]{%
	\par\noindent
	\hspace{0.5cm}#1\par
	\vspace{-6pt}%
}

\newcommand{\l@chapterwithsub}[2]{%
	\@dottedtocline{1}{0.5cm}{1.5cm}{\fontsize{10}{14}\selectfont#1}{#2}%
}

% Specific command to disable author's name in viewer TOC and Bookmark
\newif\ifijauthorbookmark
\ijauthorbookmarktrue

%=========================================================
% Document's title body
%=========================================================

\renewcommand{\maketitle}{%
\begin{center}%
	% Prints the title
	{\section*{\MakeUppercase{\@title}}\par}%
	
	% Adds the title to TOC in capital letters
	\addtocontents{toc}{%
		\protect\contentsline{titlewithoutpage}{\MakeUppercase{\@title}}{}{}%
	}%
	{\fontsize{12}{14}\selectfont\itshape\@author\par}%
	
	% Adds the author's name and page number under the title
	\ifx\chaptersubtitle\@empty\else
		\phantomsection
		\ifijauthorbookmark
			% Authors name in document and viewer TOC, but makes the title be in the bookmark
			\addcontentsline{toc}{chapterwithsub}{%
				\texorpdfstring{\textit{\@tocauthor}}{\MakeUppercase{\@title}}%
			}%
		\else
			% completely removes the author's name or title be in the bookmark
			\begingroup
			\let\Hy@writebookmark\@gobblefive
			\addcontentsline{toc}{chapterwithsub}{%
				\textit{\@tocauthor}%
			}%
			\endgroup
		\fi
	\fi

	% If no afiliation leaves space in blanc
	\vspace{-0.01cm}%
	\ifx\@affiliations\empty\else
		\par
		{\fontsize{12}{14}\selectfont
			\parbox{\textwidth}{%
				\centering
				\@affiliations
			}%
		}%
		\par
	\fi
	% If no corresponding mail leaves space in blanc
	% It can also add custom text before the email
	\ifx\@correspondingmail\empty
		\vspace*{-0.5cm}
		\else
		\ifx\@correspondingtext\empty
			\vspace{0.1cm}%
			{\href{mailto:\@correspondingmail}{\nolinkurl{\@correspondingmail}}\par}%
		\else
			\vspace{0.1cm}%
			{\@correspondingtext\ \href{mailto:\@correspondingmail}{\nolinkurl{\@correspondingmail}}\par}%
		\fi
		\par
	\fi
\end{center}%
%\par
\aftergroup\leavevmode
\par
\normalfont
}

%==============================
% Abstract (spanish)
%==============================

\newenvironment{resumen}{%
	\aftergroup\leavevmode
	\begingroup
	\par
	\@afterheading
	\@nobreakfalse
	\setlength{\parindent}{0pt}%
	\vspace{-0.7cm}
	\begin{center}
	{\fontsize{14}{14}\selectfont\textbf{RESUMEN}}
	\vspace{-0.5cm}
	\end{center}
	\justify
}{%
	\par\vspace{6pt}%
	\endgroup
	\vspace{-.5cm}
}

%==============================
% Keywords (spanish)
%==============================

\newcommand{\pclave}[1]{%
	\vspace{-0.8cm}
	\begin{center}
	\textit{\fontsize{10}{10}\selectfont\noindent\emph{Palabras clave:}~#1}
	\vspace{12pt}\par
	\end{center}
}

%==============================
% Abstract
%==============================

\newenvironment{abstract}{%
	\par
	\@afterheading
	\@nobreakfalse
	\setlength{\parindent}{0pt}%
	\vspace{-1cm}
	\begin{center}
	{\fontsize{14}{14}\selectfont\textbf{ABSTRACT}}
	\vspace{-0.5cm}
	\end{center}
	\justify
}{%
	\par\vspace{6pt}%
}

%==============================
% Keywords
%==============================

\newcommand{\keywords}[1]{%
	\vspace{-0.8cm}
	\begin{center}
	\textit{\fontsize{10}{10}\selectfont\noindent\emph{Keywords:}~#1}
	\vspace{12pt}\par
	\end{center}
}
