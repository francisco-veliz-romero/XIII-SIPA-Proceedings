\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sipa-references}[2026/10/01 SIPA References]

% ===============================================================================================
% APA-7 customized references
% ===============================================================================================

% Forces the name - year title in the references
\DeclareSortingTemplate{editor-year-title}{%
	\sort{
		\field{presort}
	}
	\sort[final]{
		\field{sortkey}
	}
	\sort{
		\name{editor}
		\name{author}
		\name{translator}
	}
	\sort{
		\field{sortyear}
		\field{year}
		\field{month}
		\field{day}
	}
	\sort{
		\field{title}
	}
}

% Acknowledeges bookauthor as an entry for references
\AtBeginDocument{
	\renewbibmacro*{name:bookauthor}{%
		\ifnameundef{bookauthor}
		{}
		{\printnames{bookauthor}\addcomma\space}
	}
}

% Allows cycling through the options without leaving uggly empty spaces
\newtoggle{prevprinted}

\newbibmacro{transedvolnumpages}{%
	\togglefalse{prevprinted}%
	% Translator
	\ifnameundef{translator}{}{%
		\printnames{translator}\addcomma\space Trad.%
		\toggletrue{prevprinted}%
	}%
	% Edition
	\iffieldundef{edition}{}{%
		\iftoggle{prevprinted}{\addcomma\space}{}%
		\printfield{edition}%
		\toggletrue{prevprinted}%
	}%
	% Volume
	\iffieldundef{volume}{}{%
		\iftoggle{prevprinted}{\addcomma\space}{}%
		\printfield{volume}%
		\toggletrue{prevprinted}%
	}%
	% Number
	\iffieldundef{number}{}{%
		\iftoggle{prevprinted}{\addcomma\space}{}%
		\printfield{number}%
		\toggletrue{prevprinted}%
	}%
	% Pages
	\iffieldundef{pages}{}{%
		\iftoggle{prevprinted}{\addcomma\space}{}%
		\printfield[pages]{pages}%%
	}%
}

% Rework of inbook entry
\DeclareBibliographyDriver{inbook}{%
	\usebibmacro{bibindex}%
	\usebibmacro{begentry}%
	\printnames{author}%
	\addspace%
	\mkbibparens{\printlabeldateextra}%
	\newunit\newblock
	\printfield{title}%
	.\space%
	% Sole editor or author entry
	\ifnameundef{editor}{En: }{%
		\printtext{En:\space}%
		\printnames{editor}%
		\addspace
		\mkbibparens{%
			\ifmorenames
			{Ed.}
			{Eds.}%
		}%
	}%
	% Connector for both editor and author entries
	\ifboolexpr{
		not test {\ifnameundef{editor}}
		and
		not test {\ifnameundef{bookauthor}}
	}
		{\addspace \rotatebox[origin=c]{180}{\&}\addspace}
		{}
	% Bookauthor entry
	\ifnameundef{bookauthor}{}{%
			\printnames{bookauthor}%
			\newunit\newblock
	}%
	\printfield{booktitle}%
	\iffieldundef{booksubtitle}{}{%
		\textit{%
			\setunit{\subtitlepunct}%
			\printfield{booksubtitle}
		}%
	}%
	\addspace%
	% Translator, edition, volume, number and pages. Cause' it looks cool as hell (and it's informative)
	\mkbibparens{\usebibmacro{transedvolnumpages}}%
	\newunit\newblock
	% Location / address & publisher
	\printlist{location}%
		\iflistundef{location}{}{%
			\setunit{\addcolon\space}
		}%
	\printlist{publisher}%
	\newunit\newblock
	% DOI y URL
	\usebibmacro{doi+eprint+url}%
	%
	\usebibmacro{finentry}%
}

\renewbibmacro*{editorstrg}{%
	\mkbibparens{\usebibmacro{editorstrg@apa}}%
}

% Rework of book entry
\DeclareBibliographyDriver{book}{%
	\usebibmacro{bibindex}%
	\usebibmacro{begentry}%
	% Editor
	\ifnameundef{editor}{%
		% Print author if no editor
		\printnames{author}%
	}{%
		% Print Editor first
		\printnames{editor}%
		\addspace%
		\mkbibparens{%
			\ifnumgreater{\value{editor}}{1}
				{Eds.}
				{Ed.}%
		}%
		% If Author also exists
		\ifnameundef{author}{}{%
			\addspace \rotatebox[origin=c]{180}{\&} \addspace%
			\printnames{author}%
		}%
	}%
	% Year
	\addspace%
	\mkbibparens{\printlabeldateextra}%
	\newunit\newblock
	% Title
	\printfield{title}%
	\iffieldundef{subtitle}{}{%
		\setunit{\subtitlepunct}%
		\printfield{subtitle}%
	}%
	\addspace%
	% Translator, edition, volume, number and pages. Cause', as I said before, looks cool as hell (and it's informative)
	\mkbibparens{\usebibmacro{transedvolnumpages}}%
	\newunit\newblock
	% Location / address & publisher
	\printlist{location}%
	\iflistundef{location}
		{}
		{\setunit{\addcolon\space}}%
	\printlist{publisher}%
	\newunit\newblock
	% DOI y URL
	\usebibmacro{doi+eprint+url}%
	%
	\usebibmacro{finentry}%
}

% Location and publisher for Theses
\xpatchbibdriver{thesis}
	{\printlist{publisher}}
	{\printlist{publisher}:\space%
	\printlist{location}}
	{}
	{}

% Add Day, Month and Year (though it seems to be broken)
\DeclareFieldFormat{date}{%
	\iffieldundef{year}{}{%
		\thefield{year}%
		\iffieldundef{month}{}{~\mkbibmonth{\thefield{month}}}%
		\iffieldundef{day}{}{~\thefield{day}}%
	}%
}

\renewbibmacro*{date}{%
	\printfield{date}%
}

% Option to print a numbered apa-style bibliography
% add env=numberedbibliography to printbibliography
\defbibenvironment{numberedbibliography}
	{\list
		{\mkbibbrackets{\arabic{enumiv}}}
		{%
			\usecounter{enumiv}%
			\setlength{\labelwidth}{0pt}%
			\setlength{\labelsep}{0.5em}%
			\setlength{\leftmargin}{\bibhang}%
			\setlength{\itemindent}{-\bibhang}%
			\setlength{\listparindent}{0pt}%
			\setlength{\itemsep}{\bibitemsep}%
			\setlength{\parsep}{\bibparsep}%
			\setlength{\topsep}{0pt}%
			\setlength{\partopsep}{0pt}%
		}%
	}
	{\endlist}
	{\item}

% Fores p. and pp. for pages, Vol. for volume, and No. for number
\DeclareFieldFormat[article]{pages}{#1}
\DeclareFieldFormat[book,inbook]{pages}{\mkpageprefix[bookpagination]{#1}}
\DeclareFieldFormat[book,inbook,collection,incollection,proceedings,inproceedings]{volume}{Vol.\addnbspace#1}
\DeclareFieldFormat[book,inbook,collection,incollection,proceedings,inproceedings]{number}{No.\addnbspace\emph{#1}}
