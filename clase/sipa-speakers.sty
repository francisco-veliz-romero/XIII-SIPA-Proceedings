	% Left speaker's image
	\node[anchor=center,inner sep=0pt,] at (17mm,-48.5mm) {%
		\includegraphics[width=30mm, height=100mm, keepaspectratio]{\confImageOne}%
	};
	
	%	Right School / Faculty / workplace image
	\node[anchor=north east,inner sep=0pt] at ([xshift=0mm,yshift=-1mm]school.south east){%
		\includegraphics[width=30mm, height=30mm, keepaspectratio]{\confImageTwo}%
	};
	
\end{tikzpicture}%
\par\vspace{1mm}%
}
