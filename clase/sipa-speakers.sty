\newcommand{\conferencetwo}{%
\noindent
\begin{tikzpicture}[baseline=(current bounding box.north)]
	
	\def\confancho{\textwidth}
	\def\confalto{30mm}
		
	\node[anchor=north west, inner sep=0pt,
	minimum width=\confancho, minimum height=\confalto] (marco) at (0,0) {};
	
	%============================
	%	Header
	%============================
	
	\node[anchor=north, align=center, text width=\textwidth,
		font=\sffamily\bfseries\fontsize{20}{28}\selectfont]
	(name) at (\confancho/2,-1) {\confName};

	\ifhasflag
		% Left flag
		\node[anchor=west,inner sep=0pt] at ([xshift=5mm, yshift=1mm]name.west) {\raisebox{-1.5mm}{\confFlag}};

		% Right flag
		\node[anchor=east,inner sep=0pt] at ([xshift=-5mm, yshift=1mm]name.east) {\raisebox{-1.5mm}{\confFlag}};
	\fi

	% Divisor rectangles
	\node[anchor=north, minimum width=\textwidth,
	minimum height=5pt,fill=darkgreen, inner sep = 0pt]
	at ([xshift=0,yshift=9mm]name.center) {};
	
	\node[anchor=north, minimum width=\textwidth,
	minimum height=5pt,fill=darkgreen, inner sep = 0pt] (rule)
	at ([xshift=0,yshift=-7mm]name.center) {};

	%============================
	%	Body
	%============================

	\node[anchor=north west,inner sep=0pt,text width=0.8\textwidth, 
	align=left, font=\sffamily] (school) at ([xshift=35mm,yshift=-2.5mm]rule.south west) {%
		{\fontsize{16}{20}\selectfont \confSchool \par}
	};
	
	\def\conf@prevnode{school}
	
	% The faculty / job and title are the names for the node (it allows the nodes to be placed without leaving blanc lines
