%=========================================================
% Function to print multiple parshape
%=========================================================

% Special thanks to David Carlisle & Pieter van Oostrum for this hell of a code
% https://tex.stackexchange.com/questions/127504/more-condensed-version-of-parshape
\def\newparshape{\parshape\@npshape0{}}
\def\@npshape#1#2#3{\ifx\\#3\expandafter\@@@npshape\else\expandafter\@@npshape\fi
{#1}{#2}{#3}}
\def\@@npshape#1#2#3#4#5{%
\ifnum#3>\z@\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi
{\expandafter\@@npshape\expandafter{\the\numexpr#1+1\relax}{#2 #4 #5}{\numexpr#3-1\relax}{#4}{#5}}%
{\@npshape{#1}{#2}}}
\def\@@@npshape#1#2#3{#1 #2 }

%=========================================================
% Functions to introcudce data
%=========================================================

% Saves flags
\newcommand{\confFlag}{}
\newcommand{\confFlagTwo}{}

% Specific if for Flag
\newif\ifhasflag
\hasflagfalse

\newcommand{\bandera}[1]{%
	\if\relax\detokenize{#1}\relax
		\hasflagfalse
	\else
		\hasflagtrue
		\gdef\confFlag{\worldflag[width=8mm, length=16mm]{#1}}%
		\gdef\confFlagTwo{\hfill\raisebox{-3mm}{\worldflag[width=8mm, length=16mm]{#1}}}%
	\fi
}

% Speaker's name
\newcommand{\confname}[1]{%
	\gdef\confName{#1}%
}

% Speaker's school or workplace name
\newcommand{\confsch}[1]{%
	\gdef\confSchool{#1}%
}

% Speaker's specific faculty or workplace name
\newcommand{\conffac}[1]{%
	\gdef\confFaculty{#1}%
}

% Speaker's job
\newcommand{\confjob}[1]{%
	\gdef\confJob{#1}%
}

% Speaker's conference title
\newcommand{\conftitl}[1]{%
	\gdef\confTitle{#1}%
}

% Speaker's photo
\newcommand{\confimgone}[1]{%
	\gdef\confImageOne{#1}%
}

% Speaker's school / faculty / workplace photo
\newcommand{\confimgtwo}[1]{%
	\gdef\confImageTwo{#1}%
}

% Command to automatically add nested nodes
\newcommand{\conf@addnode}[3]{%
	\ifx#3\empty\else
		\node[anchor=north west, inner sep=0pt, text width=0.6\textwidth,
			align=left, font=\sffamily] (#1) at ([xshift=0mm,yshift=-2mm]\conf@prevnode.south west) {%
			{\fontsize{#2}{#2}\selectfont #3\par}%
		};
		\xdef\conf@prevnode{#1}%
	\fi
}

% Speaker's bibliography or custom text (For Keynote lectures)
\newcommand{\confText}{}
\newcommand{\conftext}[4]{%
\gdef\confText{%
	\begin{justify}
	\newparshape
		{#1}{0.17\textwidth}{0.70\textwidth}
		{#2}{0.17\textwidth}{0.83\textwidth}
		{#3}{0\textwidth}{1\textwidth}\\%
	\vspace{-0.2cm}%
	\noindent
	#4%
	\end{justify}%
	}%
}

% Speaker's semblance or custom text (for semblances block)
\newcommand{\semblanceText}{}
\newcommand{\semblancetext}[3]{%
\gdef\semblanceText{%
    	\begin{justify}
	\newparshape
		{#1}{0.17\textwidth}{0.83\textwidth}
		{#2}{0\textwidth}{1\textwidth}\\%
		\vspace{-0.2cm}%
		\noindent
		#3%
	\end{justify}%
	}%
}

%=========================================================
% Speaker's blocks (in use)
%=========================================================

\newcommand{\conference}{%
\parshape 0
\ifhasflag
	{\fontsize{16}{18}\selectfont \subsection*{\confName \confFlagTwo}}
\else
	{\fontsize{16}{18}\selectfont \subsection*{\confName}}
\fi
\vspace{-3.5mm}
\leftskip=0pt
\rightskip=0pt
\raggedright
{\fontsize{14}{20}\selectfont\noindent \confSchool}\\
\ifx\confFaculty\empty
	{\fontsize{14}{15}\selectfont\noindent\itshape \confJob}\\[-3mm]
\else
	{\fontsize{14}{15}\selectfont\noindent\itshape \confFaculty}\\
	{\fontsize{14}{15}\selectfont\noindent\itshape \confJob}\\[-3mm]
\fi
\noindent
\leftskip=0pt
\rightskip=0pt
% if the speaker picture appears at the right text margin, add the following to fix it:
% xshift=\textwidth]
\begin{tikzpicture}[remember picture, overlay]
	
	% Left Speaker Image
	\node[anchor=north west] at (0,0) {%
		\includegraphics[width=0.15\textwidth]{\confImageOne}%
	};

	% Right School / Faculty / workplace logo
	\node[anchor=north east, inner sep=0pt] at (\textwidth,0) {%
		\includegraphics[width=20mm, height=20mm, keepaspectratio]{\confImageTwo}%
	};
\end{tikzpicture}

\confText

\par\vspace{1mm}%
}

%=========================================================
% Semblance block (in use)
%=========================================================

\newcommand{\semblance}{%
\parshape 0
\par
\ifhasflag
	{\fontsize{16}{18}\selectfont \subsection*{\confName \confFlagTwo}}
\else
	{\fontsize{16}{18}\selectfont \subsection*{\confName}}
\fi
\vspace{-3.5mm}
{\fontsize{14}{15}\selectfont\noindent \confSchool\par}
\noindent
\leftskip=0pt
\rightskip=0pt
\vspace{-3.5mm}
\begin{tikzpicture}[remember picture, overlay]
	% Semblance's person image
	\node[anchor=north west] at (-1mm,3mm) {%
		\includegraphics[width=0.15\textwidth]{\confImageOne}%
	};
\end{tikzpicture}

\semblanceText

\par\vspace{1mm}%
}

