\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sipa-page-formats}[2026/09/30 SIPA Page formats]

% ===============================================================================================
% Page formats
% ===============================================================================================

%============================
% Sections
%============================

\fancypagestyle{plain}{%
	\fancyhf{}
	
	\fancyhead[C]{%
		\makebox[0pt][c]{\headerplain}%
		\fontsize{18}{16}\selectfont%
		\textcolor{white}{\eventnumber\space\eventshorttitle\space --- Memorias}\\[5pt]
	}
	
	\fancyfoot[L]{%
		\makebox[210mm][c]{\footernopages}%
	}

	% Removes header and footer rules globally
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
}

%============================
%	Pre TOC header
%============================

\fancypagestyle{preindex}{%
	\fancyhf{}
	
	\fancyhead[C]{%
		\makebox[0pt][c]{\headertoc}%
		\fontsize{18}{16}\selectfont
		\textcolor{white}{\eventnumber\space\eventshorttitle\space --- Memorias}\\[5pt]
	}
	
	\fancyfoot[L]{%
		\makebox[210mm][c]{\footerpages}%
	}
	
	% Removes header and footer rules globally
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
}

%============================
% Post TOC content
%============================

\fancypagestyle{posindex}{%
	\fancyhf{}
	
	\fancyhead[C]{%
		\headermain
		\vspace{-2.5mm}
		\begin{minipage}[t][\headheight][t]{\textwidth}
			\centering\color{black}
			{\fontsize{14}{20}\selectfont
			\textcolor{white}{\eventnumber\space\eventshorttitle\space --- Memorias}\\[1.2mm]
			% Adds Author abbreviated name, custom section name, or remove this line in header
			\ifcase\@pagenblanc
				% yes
				\textbf{\parttitle}\\[-0.2mm]
				\@nombsec
				\par
				\vspace{-2.2mm}
				\rule{\textwidth}{2pt}
			\or
				% no
				\textbf{\parttitle}\\[-0.2mm]
				\@abbrevnombs
				\par
				\vspace{-2.2mm}
				\rule{\textwidth}{2pt}
			\or
				% alone
				\vspace{3mm}
				\textbf{\parttitle}\\
				\par
				\vspace{1.8mm}
				\rule{\textwidth}{2pt}
			\fi%
			}
		\end{minipage}%
	}
	
	\fancyfoot[LE]{%
		\makebox[210mm][c]{\sipafooterright}%
	}
	
	\fancyfoot[RO]{%
		\makebox[210mm][c]{\sipafooterleft}%
	}
	
	% Removes header and footer rules globally
	\renewcommand{\headrulewidth}{0pt}
	\renewcommand{\footrulewidth}{0pt}
}
